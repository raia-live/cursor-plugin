{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/room-tool-used.sh\"",
        "matcher": "MCP:.*amfs_room_(join|redeem|accept_invite|wait)",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/room-wait-rearm.sh\"",
        "loop_limit": 20,
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/room-wait-reset.sh\"",
        "timeout": 5
      }
    ]
  }
}
