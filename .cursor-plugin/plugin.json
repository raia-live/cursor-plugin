  "license": "Apache-2.0",
  "logo": "assets/logo.png",
  "keywords": [
    "senselab",
    "memory",
    "agent-memory",
    "knowledge-base",
    "multi-agent",
    "rooms",
    "mcp"
  ],
  "category": "developer-tools",
  "tags": [
    "memory",
    "mcp",
    "knowledge",
    "collaboration"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "AMFS_API_KEY": {
        "type": "string",
